# ============================================================================
# E-Commerce Backend - Environment Variables
# ============================================================================
# Copy this file to .env and update values as needed
# For development, default values are fine!
# ============================================================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_PASSWORD=redis_password

# JWT Secret (change in production!)
JWT_SECRET=your-secret-key-change-this-in-production-use-openssl-rand-hex-32

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin

# Kafka
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ============================================================================
# NOTE: For development, you can use these default values.
# For production, please change all passwords and secrets!
# ============================================================================
